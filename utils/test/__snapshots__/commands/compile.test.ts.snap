import { Model as OldModel } from "../version-30.0.0/model.js";

import { Model as NewModel } from "./model.js";

export default function transform(model: OldModel): NewModel {
	return {
		...model,
		content: {
			...model.content,
			stringField: "Hello World"
		}
	};
}

{
	"compilerOptions": {
		"ignoreDeprecations": "6.0",
		"target": "ES2025",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["DOM", "ES2025"],
		"esModuleInterop": true,
		"isolatedModules": true,
		"rootDir": ".",
		"sourceMap": false,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["cypress"]
	},
	"include": ["./**/*.ts"]
}

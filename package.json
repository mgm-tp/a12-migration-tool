{
	"name": "root",
	"type": "module",
	"private": true,
	"engines": {
		"node": "^22",
		"pnpm": "^11.0.0"
	},
	"scripts": {
		"clean": "pnpm -r --parallel clean",
		"compile": "pnpm -r compile",
		"start": "pnpm -r --parallel start",
		"test": "pnpm -r test",
		"lint": "pnpm \"/lint:/\"",
		"lint:detect-cycle": "devtools detect-cycles \"./core/src/**/*.ts\"",
		"lint:eslint": "eslint . --cache --quiet",
		"lint:prettier": "prettier . --check",
		"format": "pnpm \"/format:/\"",
		"format:eslint": "eslint . --fix --quiet",
		"format:prettier": "prettier . --write"
	},
	"author": "mgm technology partners",
	"devDependencies": {
		"@com.mgmtp.a12.devtools/build-tools": "catalog:",
		"@eslint/compat": "catalog:",
		"@com.mgmtp.a12.devtools/eslint-config": "catalog:",
		"@com.mgmtp.a12.devtools/prettier-config": "catalog:",
		"@com.mgmtp.a12.devtools/tsconfig": "catalog:",
		"eslint": "catalog:",
		"eslint-plugin-notice": "catalog:",
		"prettier": "catalog:",
		"typescript": "catalog:"
	},
	"a12Version": "2026.06-ext0",
	"packageManager": "pnpm@11.5.2"
}
